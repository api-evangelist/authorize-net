    "name": "Authorize.Net Transactions API",
    "description": "Best-effort OpenAPI 3.1 description of the Authorize.Net payments API.\nAuthorize.Net uses a single-endpoint architecture: all operations are POSTed\nto /xml/v1/request.api with the operation selected via a transaction or\nrequest type inside the JSON body. Derived from the public reference at\nhttps://developer.authorize.net/api/reference/.\n\n\nContact Support:\n Name: Authorize.Net Developer Center",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-07-28T01:06:09.000Z",
    "updatedAt": "2026-07-28T01:06:09.000Z",
    "lastUpdatedBy": "35240",
    "uid": "35240-5377d2ab-3d58-4d16-aa63-5f4df8b54dc0"
  },
